{
  "name": "free-color-picker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-pages.mjs && node scripts/generate-sitemap.mjs && node scripts/inject-more-tools.mjs",
    "lint": "biome check src --max-diagnostics=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.4.3",
    "vite": "^7.0.0",
    "vitest": "^3.1.2",
    "wrangler": "^3.94.0"
  }
}